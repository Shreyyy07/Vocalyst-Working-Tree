# ============================================================
# Vocalyst — Environment Variables Template
# Copy this file to .env and fill in your actual keys
# ============================================================

# ── AI / ML API Keys ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
NEUPHONIC_API_KEY=your_neuphonic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Frontend API URL ─────────────────────────────────────────
# LOCAL development → Flask runs on localhost
# VERCEL (production) → Set this to your HuggingFace Space URL
#   e.g. https://your-username-vocalyst-backend.hf.space
NEXT_PUBLIC_API_URL=http://localhost:5328

# ── Flask (backend only) ─────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
